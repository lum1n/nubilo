<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyLists/1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	The App Sandbox is off on purpose. The Mac app runs the bundled `nubilo`
	binary, which serves on ports 443/8443, writes ~/.nubilo and
	~/.nubilo-agent, installs LaunchAgents in ~/Library/LaunchAgents and
	opens a browser. A sandboxed parent would force all of that into the
	sandbox too (child processes inherit it), which the server cannot run in.
	That also means the macOS build cannot ship on the Mac App Store; it is
	distributed signed with Developer ID and notarized.
	-->
	<key>com.apple.security.app-sandbox</key>
	<false/>
	<!-- Hardened Runtime blocks Photos access without this (photo backup). -->
	<key>com.apple.security.personal-information.photos-library</key>
	<true/>
	<!-- Calendar mirror (EventKit, read-only). -->
	<key>com.apple.security.personal-information.calendars</key>
	<true/>
	<!--
	Shared with the Finder extension (NubiloFilesMac), which reads the
	pairing and device key through SharedCredentials in the data protection
	keychain. This entitlement needs a provisioning profile (automatic
	signing with a team creates one, also for Developer ID).
	-->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)dev.nubilo.shared</string>
	</array>
	<!-- Same team-prefixed app group as the Finder extension. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>$(TeamIdentifierPrefix)dev.nubilo.shared</string>
	</array>
</dict>
</plist>
