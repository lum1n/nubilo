<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyLists/1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	Shared with the Files extension (FilesExtension/), which reads the pairing
	and device key through SharedCredentials. Items stored before this group
	existed stay in the app's default group and are still found.
	-->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)dev.nubilo.shared</string>
	</array>
	<!-- Apple's File Provider template pairs the extension with an app group. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.dev.nubilo.shared</string>
	</array>
</dict>
</plist>
